# Origin of the analysis service (FastAPI). Used by the /api/* rewrite in next.config.ts.
ANALYSIS_API_ORIGIN=http://127.0.0.1:8000
# Optional: shows a GitHub link in the top bar when set.
# NEXT_PUBLIC_REPO_URL=

# Static-data deployment (Vercel, no Python service): reads /snapshot/ only and emits no /api rewrite.
# Generate the snapshot first (see README "Deploying"); it is gitignored.
# NEXT_PUBLIC_DATA_MODE=snapshot
