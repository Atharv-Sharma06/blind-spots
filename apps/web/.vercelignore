# Present on purpose: with a .vercelignore the Vercel CLI no longer falls back to .gitignore, so the
# gitignored public/snapshot/ (generated per deployment) IS uploaded. Do not add it here.
node_modules
.next
.next-*
test-results
playwright-report
tests
shots
*.tsbuildinfo
.DS_Store
.env*.local
# iCloud/Finder conflict copies ("name 2.json", "BUILD_ID 3"); real snapshot files never contain a space.
public/snapshot/files/* *
* [0-9]
* [0-9].*
*.tmp
